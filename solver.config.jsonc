// Omitted settings use built-in defaults. Restart the optimizer after editing.
{
  // Set any strategy’s enabled flag to false to disable it.
  "strategies": {
    // Rainbow lookups in local search and dependency cuts.
    "rainbow": {
      "enabled": true // Run this strategy when eligible.
    },
    // Remove or substitute wires, then prove equivalence.
    "variables": {
      "enabled": true, // Run this strategy when eligible.
      "exactMaximumWires": 7, // Exhaustively evaluate variable rewrites up to this wire count.
      "sampleCandidates": true, // Try sampling larger variable candidates before exact polynomial proof.
      "samples": 202 // Sample inputs used to reject larger variable candidates.
    },
    // Search noncontiguous dependency regions in global search.
    "dependencyCuts": {
      "enabled": true // Run this strategy when eligible.
    },
    // Prove equivalent expressions and remove redundant writes.
    "satSweeping": {
      "enabled": true, // Run this strategy when eligible.
      "cutsFirst": false // Try ranked cuts before whole-region SAT.
    },
    // Cancel XOR updates across reversible basis changes.
    "mixedBasis": {
      "enabled": true // Run this strategy when eligible.
    },
    // Cancel commuting repeated blocks and inverse operations.
    "blockCancellation": {
      "enabled": true // Run this strategy when eligible.
    },
    // Simplify factored Boolean expressions.
    "factored": {
      "enabled": true // Run this strategy when eligible.
    },
    // Simplify affine regions using GF(2) linear algebra.
    "gf2Affine": {
      "enabled": true // Run this strategy when eligible.
    },
    // Simplify quadratic regions and enable quadratic whole-region symbolic synthesis.
    "quadratic": {
      "enabled": true // Run this strategy when eligible.
    },
    // Enumerate short replacements by forward semantic search.
    "forwardSemantic": {
      "enabled": true // Run this strategy when eligible.
    },
    // Use SMT to find small equivalent circuits.
    "smt": {
      "enabled": true // Run this strategy when eligible.
    },
    // Find small replacements by joining two semantic searches.
    "meetInMiddle": {
      "enabled": true // Run this strategy when eligible.
    },
    // Explore small circuits using exact prefix equivalence and gate commutation.
    "equalitySaturation": {
      "enabled": true // Run this strategy when eligible.
    },
    // Shared graph limits for SAT sweep, factored, mixed-basis and block cancellation.
    "factoredLimits": {
      "maximumNodes": 200000, // Maximum total factored forms and product nodes.
      "maximumEdges": 16000000 // Maximum factored graph edges and expansion work.
    },
    // Limits for affine and quadratic search and exact polynomial proofs.
    "polynomialLimits": {
      "maximumWindowGates": 256, // Maximum region size for local symbolic search and exact splice admission.
      "maximumTerms": 100000, // Maximum total terms in an exact polynomial representation.
      "maximumOperations": 10000000 // Maximum term operations per exact polynomial computation.
    },
    // Limits for forward semantic search, SMT, meet-in-the-middle and equality saturation.
    "smallSynthesisLimits": {
      "maximumWires": 3, // Maximum active wires for small synthesis.
      "maximumWindowGates": 8, // Maximum region size for bounded small synthesis.
      "maximumReplacementGates": 3, // Maximum gates in a small synthesized replacement.
      "states": 2000 // State cap for bounded small semantic searches.
    }
  },
  // Process resource settings.
  "runtime": {
    "heapMegabytes": 16384 // Node heap limit in MiB.
  },
  // Input, output and scratch paths.
  "files": {
    "dataDirectory": "data", // Base directory for working data.
    "workerDirectory": "worker", // Name of the worker scratch directory under dataDirectory.
    "latestName": "latest.json", // Checkpoint suffix beside the input, after the puzzle name and a hyphen.
    "progressDirectory": "progress", // Default snapshots sit beside the input. A custom name creates per-puzzle folders under dataDirectory.
    "databaseDirectory": "." // Directory containing rainbow databases.
  },
  // Worker concurrency, scheduling and memory.
  "workers": {
    "keepBusy": true, // Refill workers continuously during a round.
    "wholeCircuitMaximumGates": 2000, // Maximum gate count for whole-circuit local jobs. Zero always splits.
    "maximum": 8, // Upper bound on concurrent workers.
    "minimumChunkGates": 100, // Lower bound used for the worker chunk-size target.
    "maximumChunkFraction": 0.5, // Largest chunk-size target as a fraction of the circuit.
    "jobsPerWorker": 4, // Number of local job lanes queued per worker.
    "jobSeconds": 120, // Time budget for each worker job.
    "adaptiveConcurrency": true, // Tune worker concurrency in non-continuous scheduling mode.
    "initialConcurrency": 4, // Starting worker concurrency for adaptive scheduling.
    "concurrencySampleRounds": 2, // Rounds to sample before adjusting adaptive concurrency.
    "concurrencyDatabaseFraction": 0.6, // Database-time fraction used by the concurrency controller.
    "concurrencyRateTolerance": 0.05, // Relative throughput tolerance for concurrency changes.
    "memoryBudgetMegabytes": 8192, // Worker memory budget in MiB.
    "broadSearchSeconds": 60 // Positive enables global search. Zero disables it.
  },
  // Round, status and checkpoint intervals.
  "timing": {
    "checkpointSeconds": 30, // Seconds between attempts to save the best candidate.
    "roundMinutes": 25, // Round target in minutes when local search has no gate reduction.
    "improvedRoundMinutes": 5, // Round target in minutes once local search removes gates.
    "summarySeconds": 30, // Seconds between console progress summaries.
    "workerReportSeconds": 5, // Seconds between worker progress reports.
    "databaseLogSeconds": 60, // Seconds between database-generation status updates.
    "standaloneSaveSeconds": 60 // Seconds between saves in standalone optimization.
  },
  // Console output and diagnostics.
  "logging": {
    "verbose": false, // Enable detailed optimizer logging.
    "generationDiagnostics": true, // Enable database generation diagnostics.
    "generationDiagnosticsMinimumSeconds": 5, // Minimum generation duration for detailed diagnostics.
    "eventLoopResolutionMilliseconds": 20 // Event-loop sampling interval in milliseconds.
  },
  // Shared equivalence checking limits.
  "validation": {
    "checkpointInputs": 20, // Random inputs for wide checkpoint validation and worker checks.
    "maximumWires": 64 // Maximum wire count accepted by the optimizer and verification.
  },
  // Region selection and search infrastructure shared by strategies.
  "search": {
    "strategyAdaptive": true, // Keep productive strategies across rounds and rotate after misses.
    "subsetMinimum": 2, // Smallest local dependency subset in gates.
    "subsetMaximum": 199, // Largest local dependency subset in gates.
    "sliceMinimum": 2, // Smallest search window inside a local subset.
    "sliceMaximum": 199, // Largest search window inside a local subset.
    "maximumInnerChunks": 5, // Maximum pieces searched within a worker job.
    "minimumInnerChunkGates": 200, // Gate threshold for splitting worker jobs internally.
    "workerShufflePasses": 200, // Gate shuffle passes between local searches.
    "roundShufflePasses": 2000, // Gate shuffle passes between rounds when enabled.
    "adaptive": false, // Adapt region sizes and search arms based on measured results.
    "explorationEvery": 5, // Explore a different search arm every N selections.
    "searchArms": 16, // Number of region-size combinations considered by the scheduler.
    "prioritizeChangedWires": true, // Give recently changed wires priority when selecting regions.
    "incrementalEvaluation": true, // Reuse prefix snapshots during packed evaluation.
    "prefixCacheBytes": 8388608, // Byte budget for prefix snapshots per evaluator.
    "prefixStride": 16, // Minimum gate interval between prefix snapshots.
    "normalizedCacheEntries": 10000, // Maximum normalized exact-rewrite cache entries.
    "balancedWorkers": true, // Balance chunks by measured wire costs.
    "incrementalDependencies": true, // Maintain a dependency index across local rewrites.
    "schedulerDecay": 0.98, // Decay factor for prior search-arm performance.
    "localSearch": true, // Seed search near the last successful rewrite.
    "localSearchSeeds": 32, // Maximum number of nearby anchors after a rewrite.
    "localSearchRadius": 16, // Maximum gate distance when collecting nearby seeds.
    "localSearchBroadEvery": 5, // Bypass nearby anchors every N region searches.
    "circuitChunkGates": 128, // Target size of a chunk in the editable gate sequence.
    "stableSearchArms": false, // Reuse the same region-size choices across jobs.
    "schedulerHistoryEntries": 128, // Maximum remembered search-arm results.
    "independentComponents": false // Separate independent wire components before local search.
  },
  // Lookup and search cache limits.
  "cache": {
    "lookupEntries": 1000000, // Maximum cached rainbow lookups per worker.
    "processedEntries": 1000000, // Maximum remembered processed windows per worker.
    "shuffleEntries": 100000, // Maximum cached normalized shuffle results.
    "subsetEntries": 100000, // Maximum remembered tested subsets per worker.
    "windowKeyBytes": 16777216, // Byte budget for cached window keys.
    "lookupPolicy": "lru" // Evict lookup entries in FIFO or least-recently-used order.
  },
  // Rainbow table sizes, SQLite lookup and table generation.
  "database": {
    // Rainbow tables used by the optimizer.
    "tables": [
      {
        "wires": 5, // Number of wires covered by this table.
        "gates": 2 // Maximum gate count generated for this table.
      },
      {
        "wires": 4, // Number of wires covered by this table.
        "gates": 5 // Maximum gate count generated for this table.
      },
      {
        "wires": 3, // Number of wires covered by this table.
        "gates": 6 // Maximum gate count generated for this table.
      }
    ],
    "queryBatchSize": 900, // Maximum IDs per SQLite rainbow lookup batch.
    "memoryMapBytes": 268435456, // SQLite memory map budget in bytes. Zero disables mapping.
    "generationStates": 0, // Maximum generation states. Zero uses the automatic limit.
    "generationBatchRows": 3000, // Maximum candidate rows per staging write batch.
    "etaWindowSamples": 5, // Recent generation samples used for ETA.
    "etaWarmupSamples": 3, // Sample count before calculating an ETA.
    "etaSmoothing": 0.2, // Weight of the latest generation rate in the ETA estimate.
    "lookupBatchMilliseconds": 0, // Delay for coalescing concurrent lookup requests.
    "generationWorkers": 8, // Maximum database-generation workers.
    "generationQueueBatches": 2, // Maximum queued generation batches.
    "generationMinimumWork": 100000, // Minimum candidate work before generation uses parallel slots.
    "statementCacheEntries": 16, // Maximum prepared lookup statements per connection.
    "sharedTables": true, // Share eligible rainbow tables in memory between workers.
    "sharedTableBytes": 33554432, // Byte budget for shared lookup tables.
    "sharedTableMaximumRows": 100000, // Maximum rows in a shared table.
    "generationReadRows": 4096, // Rows per generation input read.
    "generationCacheMegabytes": 1024, // SQLite generation page cache in MiB.
    "generationTempStore": "file", // Use files or memory for SQLite temporary storage.
    "generationJournalMode": "wal", // SQLite journal mode during generation.
    "generationSynchronous": "full", // SQLite durability level during generation.
    "etaMaximumSlowdown": 1, // Maximum slowdown factor applied by ETA estimates.
    "generationSqlParameters": 8192, // Bind-parameter cap per generation SQL statement.
    "generationPreparedInserts": true, // Reuse prepared staging insert statements.
    "generationSortStaging": false, // Sort incoming rows before staging insertion.
    "generationStatementCacheEntries": 8, // Maximum prepared generation statements cached.
    "generationAppendStaging": false, // Append staging rows before deduplication.
    "generationAggregateMerge": true, // Aggregate staging winners before merging.
    "generationDirectInputMerge": true, // Merge incoming candidate winners directly when eligible.
    "generationPrefetch": true, // Prefetch generation input batches.
    "generationPrefetchMegabytes": 16, // Memory budget in MiB for generation prefetch.
    "generationCompactBindings": true, // Use compact bindings for staging inserts.
    "generationStagingWriters": 2, // Number of staging writer lanes.
    "etaTrendWindowSamples": 60, // Sample window used to estimate generation trends.
    "etaTrendMinimumSamples": 10, // Minimum samples required for trend-based ETA.
    "etaTrendMinimumWorkGrowth": 0.25, // Minimum relative work growth before trend correction.
    "generationCountFinalInserts": false, // Count new rows inserted into the final table.
    "generationCandidateCacheMegabytes": 128, // Cache budget in MiB for generation candidates.
    "generationStreamStaging": true, // Stream expansion output to staging writers.
    "generationStagingQueueBatches": 2 // Maximum queued batches per staging writer.
  },
  // Benchmark workloads, variants and output paths.
  "benchmark": {
    "seconds": 10, // Seconds per optimizer benchmark trial.
    "repeats": 3, // Number of trials per benchmark case and variant.
    "seed": 1729, // Random seed for repeatable benchmark trials.
    "workerCounts": [1, 2, 4], // Worker counts to benchmark.
    "maximumChecks": 0, // Maximum optimization checks per trial. Zero is unlimited.
    "outputName": "benchmark.json", // Filename for the optimizer benchmark report.
    "maximumOverrunSeconds": 30, // Extra seconds allowed for benchmark shutdown.
    "mode": "comparison", // Benchmark mode, comparison or ablation.
    "caseManifest": "benchmarks/cases.json", // Path to the benchmark case manifest.
    "caseOutputDirectory": "benchmark-cases", // Directory name for benchmark case results.
    "variants": [], // Named benchmark variants to run.
    "decayFactor": 0.98, // Benchmark override for scheduler history decay.
    // Rainbow table sizes used in generation benchmarks.
    "generationTables": [
      {
        "wires": 3, // Number of wires covered by this table.
        "gates": 3 // Maximum gate count generated for this table.
      },
      {
        "wires": 4, // Number of wires covered by this table.
        "gates": 2 // Maximum gate count generated for this table.
      }
    ],
    "generationOutputName": "generation-benchmark.json", // Filename for the generation benchmark report.
    "generationTimeoutSeconds": 600, // Timeout per generation benchmark trial.
    "dedupSeenRows": [10000, 100000, 1000000], // Existing row counts in the deduplication benchmark.
    "dedupCandidateFunctions": 2000, // Number of candidate functions in the deduplication benchmark.
    "dedupMasksPerFunction": 4, // Number of candidate masks per function.
    "dedupOutputName": "dedup-benchmark.json", // Filename for the deduplication report.
    "stagingRows": 200000, // Candidate row count in the staging benchmark.
    "stagingOutputName": "staging-benchmark.json", // Filename for the staging benchmark report.
    "stagingWideSqlParameters": 16384, // Bind-parameter limit in the wide staging benchmark variant.
    "mergeOutputName": "merge-benchmark.json", // Filename for the merge benchmark report.
    "generationStagingComparison": false, // Compare staging settings in the generation benchmark.
    "generationPrefetchComparison": false, // Compare input prefetch settings.
    "generationWriterComparison": false, // Compare staging writer configurations.
    "generationFinalComparison": false, // Compare final table merge settings.
    "finalLookupOutputName": "final-lookup-benchmark.json", // Filename for the final lookup benchmark report.
    "generationStreamingComparison": false // Compare streamed and buffered generation output.
  }
}
